<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground.

  108x108 canvas with a 72dp safe zone centred at 54,54: launchers mask this to
  a circle on Wear OS and a squircle on Pixel, and anything outside 72dp can be
  clipped by either. The mark sits inside ~62dp so it survives both, and the
  parallax the launcher applies on scroll cannot push it out of frame.

  One idea, drawn flat and geometric the way system icons are: a shot-timer
  bezel with the string burned into it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bezel: the ring the whole app is built around. -->
    <path
        android:pathData="M54,25.5a28.5,28.5 0 1,0 0.01,0z"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeAlpha="0.30" />

    <!-- Elapsed sweep, clockwise from twelve. -->
    <path
        android:pathData="M54,25.5 A28.5,28.5 0 0,1 74.15,74.15"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Shot ticks burned into the ring at their position in the string. -->
    <group>
        <path android:pathData="M54,20 L54,31" android:strokeColor="#FFFFFF"
              android:strokeWidth="4.6" android:strokeLineCap="round" />
        <path android:pathData="M70.2,24.3 L64.7,33.8" android:strokeColor="#FFFFFF"
              android:strokeWidth="4.6" android:strokeLineCap="round" />
        <path android:pathData="M82.1,36.2 L72.6,41.7" android:strokeColor="#FFFFFF"
              android:strokeWidth="4.6" android:strokeLineCap="round" />
        <path android:pathData="M86.4,52.4 L75.4,52.4" android:strokeColor="#FFFFFF"
              android:strokeWidth="4.6" android:strokeLineCap="round" />
    </group>

    <!-- Centre pip: the sweep head. -->
    <path
        android:pathData="M54,49.5a4.5,4.5 0 1,0 0.01,0z"
        android:fillColor="#FFFFFF" />
</vector>
