<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Used only by the Updates screen, and only when the user taps Check. It
      reaches api.github.com and the release CDN for this one repository. No
      telemetry, no analytics, and nothing about you or your shooting ever
      leaves the watch. See SECURITY.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Hands a downloaded APK to the system installer, which always asks the
         user to confirm. Nothing installs silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      The recoil gate samples the accelerometer with SENSOR_DELAY_FASTEST.
      Since Android 12 any rate above 200 Hz requires this permission, and
      without it registerListener throws SecurityException. It is a normal
      permission: granted at install, no runtime prompt.

      Lint flags this by default and is usually right, because most apps have
      no business here. This one does: correlating a muzzle report against a
      wrist impulse needs a window of a few milliseconds, and 200 Hz gives
      5 ms per sample, too coarse to place the impulse inside that window.
    -->
    <uses-permission
        android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"
        tools:ignore="HighSamplingRate" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="merge" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Runs without the phone app present. At a range that is the normal
             case: the phone is in a bag and may never connect during a session. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Fully qualified: the namespace is com.carlb.split (shared with the
             phone app so Play pairs them), but the code lives under .wear, so a
             relative ".MainActivity" resolves to a class that does not exist. -->
        <activity
            android:name="com.carlb.split.wear.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <service
            android:name="com.carlb.split.wear.timer.TimerService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
    </application>
</manifest>
